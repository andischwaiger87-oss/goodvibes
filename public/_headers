# Nur die pages.dev-Adressen aus dem Index nehmen.
# Der Doppelpunkt vor project und version ist ein Platzhalter
# von Cloudflare Pages, kein Tippfehler.
https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

# Sicherheits-Header fuer alle Adressen, auch die eigene Subdomain.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Avatare liegen lokal und aendern sich praktisch nie -> laenger zwischenspeichern.
/avatars/*
  Cache-Control: public, max-age=2592000

# Startseite NIE veraltet ausliefern: sonst zeigt sie nach einem Deploy
# auf Dateien, die es nicht mehr gibt (= weisse Seite).
/
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate

# Code-Dateien haben einen eindeutigen Namen pro Version -> lange cachen ist sicher.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
